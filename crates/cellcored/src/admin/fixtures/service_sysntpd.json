{
	"sysntpd": {
		"instances": {
			"instance1": {
				"running": false,
				"command": [
					"/usr/sbin/ntpd",
					"-n",
					"-N",
					"-S",
					"/usr/sbin/ntpd-hotplug",
					"-p",
					"0.openwrt.pool.ntp.org",
					"-p",
					"1.openwrt.pool.ntp.org",
					"-p",
					"2.openwrt.pool.ntp.org",
					"-p",
					"3.openwrt.pool.ntp.org"
				],
				"term_timeout": 5,
				"exit_code": 1,
				"no_new_privs": true,
				"capabilities": "/etc/capabilities/ntpd.json",
				"user": "ntp",
				"group": "ntp",
				"jail": {
					"name": "ntpd",
					"procfs": false,
					"sysfs": false,
					"ubus": true,
					"log": false,
					"ronly": false,
					"netns": false,
					"userns": false,
					"cgroupsns": false,
					"console": false
				},
				"mount": {
					"/bin/ubus": "0",
					"/usr/bin/env": "0",
					"/usr/bin/jshn": "0",
					"/usr/sbin/ntpd-hotplug": "0",
					"/usr/share/libubox/jshn.sh": "0"
				}
			}
		}
	}
}
