#!/bin/sh /etc/rc.common

START=14
STOP=85
USE_PROCD=1

start_service() {
	mkdir -p /etc/cellcore /tmp/cellcore/signal_graphs /var/run
	procd_open_instance
	procd_set_param command /usr/sbin/cellcored
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
